# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With an empty file the demo runs fully offline
# and deterministically: narratives come from a labelled fallback string,
# category matching uses the labelled lexical fallback, and remediation
# commits to a local branch instead of opening a PR. Nothing silently
# pretends to be live — the UI reports its mode via GET /api/health.
# ---------------------------------------------------------------------------

PORT=8000

# --- Narrative LLM (Anthropic) ---------------------------------------------
# BOTH of these are required to make real model calls. A key on its own does
# nothing: CTEM_LIVE_LLM is a deliberate second switch so a key present in the
# environment can never start billing by accident.
ANTHROPIC_API_KEY=
CTEM_LIVE_LLM=

# Narrative calls are advisory and must never hold the pipeline up, so they
# run with no SDK retries and a short timeout. Code generation (the agentic
# SAST/DAST fixers) needs longer.
CTEM_LLM_TIMEOUT_SECONDS=10
CTEM_LLM_CODE_TIMEOUT_SECONDS=60

# --- Semantic retrieval (Voyage) -------------------------------------------
# Enables real embeddings for vulnerability-category matching and the approved
# knowledge base. Unset, retrieval falls back to deterministic lexical
# matching, reported as "lexical-fallback" and never labelled semantic.
VOYAGE_API_KEY=
CTEM_EMBEDDING_MODEL=voyage-4-large

# --- Live code remediation -------------------------------------------------
# Needed for the SCA/SAST/DAST scenarios to clone a real repo, push a fix
# branch, and open a real pull request. Without them the npm scenarios still
# run for real locally but stop at a committed branch (their evidence says
# so); the Maven/log4j scenario needs these, since it verifies on GitHub
# Actions rather than locally. Token needs repo scope.
CTEM_REMEDIATION_REPO=
GITHUB_TOKEN=
